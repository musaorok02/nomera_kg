# Скопируйте в .env и поправьте значения
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=example.kg,www.example.kg
CSRF_TRUSTED_ORIGINS=https://example.kg,https://www.example.kg
# 1 если сайт работает по HTTPS (включает secure-cookie)
HTTPS=1

SITE_NAME=НомераКР
WATERMARK_TEXT=example.kg

# PostgreSQL (если DB_NAME пустой, используется SQLite)
DB_NAME=nomera
DB_USER=nomera
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

STATIC_ROOT=/var/www/nomera/static
MEDIA_ROOT=/var/www/nomera/media
CACHE_DIR=/var/cache/nomera

# Лимиты
UPLOADS_PER_DAY=30
MAX_UPLOAD_MB=8

# Почта (по умолчанию письма пишутся в консоль)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@example.kg
